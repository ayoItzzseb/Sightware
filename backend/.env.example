# --- Valtix - Local Edition ----------------------------------------
# Everything here is OPTIONAL - the app runs in demo mode with nothing set.
# This edition is fully local: no telemetry, no remote control, no hosted
# dashboard. All switches live in the in-app Settings panel (persisted to
# backend/data/settings.json); the keys below are only bootstrap overrides.

# Official Riot API key - https://developer.riotgames.com
# Used ONLY for the optional official match-history source (account-v1 /
# val-match-v1). Personal keys work for account-v1; val-match-v1 needs
# production approval. The key stays in this file on your disk and is never
# sent anywhere except riotgames.com.
RIOT_API_KEY=

# Shard:  na | eu | ap | kr | latam | br   (auto-detected from the client
# unless the Region setting overrides it)
RIOT_REGION=na

# Data source:  auto | local | official | demo
#   auto      local client if VALORANT is running, else demo
#   local     force the local client API (needs the game open)
#   official  force the official Riot API (needs val-match-v1 production access)
#   demo      always use generated sample data
DATA_SOURCE=auto

# Ports (backend serves both the API and the dashboard, loopback only)
BACKEND_PORT=5000
PLAYER_CACHE_TTL=60

# -- Removed in the Local Edition ------------------------------------------
# The following settings existed in v2.3.1 and are GONE, together with the
# code that used them:
#   FRONTEND_URL / SCOUT_LOCAL_FRONTEND / WS_PORT   (hosted dashboard bridge)
#   ABLY_TOKEN_ENDPOINT                             (Ably remote control)
#   DISCORD_RPC                                     (Discord Rich Presence)
#   SCOUT_SYNC / SCOUT_SYNC_URL                     (usage telemetry beacon)
#   ALLOW_LIVE_INSTALOCK                            (automatic agent select -
#     removed; see INSTALOCK.md for the policy analysis and the compliant
#     Quick Lock replacement, configured in the Settings panel)
#   SCOUT_OFFLINE_CERT_URL / SCOUT_OFFLINE_*        (appear-offline proxy)
