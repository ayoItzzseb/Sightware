# Valtix — GUI Edition environment overrides (copy to .env)
# Everything works without this file; these are the knobs that exist.

# Data source: auto (local client, fall back to demo), local, demo
#DATA_SOURCE=auto

# Region override: na eu ap kr latam br (auto-detects from the running client)
#RIOT_REGION=na

# Riot API key (optional; enables the official val/match source for lookups)
#RIOT_API_KEY=

# Rate limiting towards Riot (requests per second; 0 = unlimited)
#RIOT_MAX_RPS=10

# Quiet console logging from the Riot client layer
VALTIX_QUIET=1
